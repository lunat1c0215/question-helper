{
  "manifest_version": 3,
  "name": "Reading Helper",
  "version": "0.2.4",
  "description": "Capture a region and get a short answer.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Reading Helper (Ctrl+Shift+X)"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Capture a region and ask"
    },
    "capture_media": {
      "description": "Capture a region (single media key)"
    }
  }
}
